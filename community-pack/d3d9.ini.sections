[Mods]
; data packs in <game>\mods\<name>, built by install.cmd from your own game files
; on/off here, restart the game after changing (originals are restored automatically)
; HD textures (S2-modders 4k remakes, ~700 MB, needs a GPU with enough VRAM)
HDTextures     = on
; 2x upscaled interface textures (Real-ESRGAN), sharper HUD together with [UI] Scale
HDInterface    = on
; view distance / LOD fix (less pop-in when zoomed out)
LODFix         = on
; 32-bit shadow and depth maps instead of 16-bit (engine flag lowresDepthMap = false)
SharpShadows   = on
; soft shadow edges: 3x3 PCF in all shaders (needs a Shader Model 3 GPU)
SmoothShadows  = on
; gaussian bloom/blur and softer depth of field
ImprovedPostFX = on

[UI]
; HUD scaling for high resolutions: 1.0 = off, e.g. 1.25 / 1.5 / 2.0 (GOG build 11757 only)
Scale = 1.5
; texture filter for the scaled HUD: linear (smooth) or point (sharp, uneven pixels unless Scale is a whole number)
Filter = linear
; in-game settings menu (Dear ImGui): on/off and the key that opens it (F1-F24, Insert, Home)
Menu = on
MenuKey = F10

[Graphics]
; the game's post-processing (bloom, depth of field) - normally only with the launch parameter -postFX; FXAA and SSAO need it
PostFX = on
; supersampling: scene and interface are rendered at 2x the resolution and shrunk (much smoother edges, 4x GPU load)
Supersampling = off
; multisampling of the supersampled image: 0 = off, 2, 4, 8 (smooths polygon edges further, more GPU memory and load)
SupersamplingMSAA = 0
; shadow map resolution at the highest shadow setting: 1 = original 2048x2048, 2 = 4096x4096, 4 = 8192x8192 (GOG build 11757 only)
ShadowMapScale = 2
; water reflection resolution at the highest setting: 1 = original 2048x1024, 2 = 4096x2048, 4 = 8192x4096 (GOG build 11757 only)
ReflectionMapScale = 2
; edge smoothing of the 3D scene (needs PostFX = on and ImprovedPostFX = on)
FXAA = on
; ambient occlusion: contact shadows under trees, houses and in corners (needs PostFX = on and ImprovedPostFX = on)
SSAO = on
; SSAO darkness 0.0 - 1.0 and radius 0.25 - 4.0
SSAOStrength = 0.6
SSAORadius = 1.0
; depth of field (soft haze away from the focus): 0.0 = off ... 1.0 = original game, needs PostFX = on
DOFStrength = 0.3
; terrain: sky/ground ambient light and a fine detail layer when zoomed in (Shader Model 3, needs SmoothShadows = on)
ImprovedTerrain = on
; strength of the terrain detail layer 0.0 - 1.0
TerrainDetail = 0.5
; water: Fresnel reflection, four wave layers, sharper sun glints, lighter water and foam at the shore (Shader Model 3, needs SmoothShadows = on)
ImprovedWater = on
; houses, trees, rocks, settlers: the same sky/ground ambient light as the terrain (needs SmoothShadows = on)
ImprovedObjects = on
; rim light on settlers and animals (they stand out from the ground): 0.0 = off ... 1.0
UnitRimLight = 0.5
; bloom: soft glow around bright areas (sunlit water, white walls) - 0.0 = off ... 1.0 (needs PostFX = on)
Bloom = 0.0
; how bright an area must be to glow: 0.5 (much glows) ... 0.95 (only the brightest spots)
BloomThreshold = 0.75
; the game's distance fog: with the extended zoom it turns every object pale when zoomed far out (off = no fog)
DistanceFog = off

[Misc]
; community pack: mesh cache (faster loading). Cleared automatically after a crash, switched off if its folder is not writable
MeshCache = on
; community pack: fixes for bugs of the original game (GOG 11757)
; clocks count from game start instead of Windows start (animations stay smooth with long PC uptime)
TimeFix = on
; profiles and savegames are written to a temporary file first (no damaged files after a crash while saving)
SafeSave = on
; multiplayer robustness: network buffer overflow, unchecked indices in game commands, commands of players who left
GameFixes = on
; 4 GB memory: keeps memory below 2 GB for the game's shader compiler, which fails above 2 GB (only active with the 4 GB flag)
LowHeap = on
; skip all startup videos (logos and intro film): straight to the main menu
SkipIntro = off
